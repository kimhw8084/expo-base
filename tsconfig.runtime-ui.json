{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "apps/reference/**/*.ts",
    "apps/reference/**/*.tsx",
    "apps/reference/expo-env.d.ts",
    "apps/reference/.expo/types/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/build/**"
  ]
}
